# Copy to .env (git-ignored) and fill in. Never commit real values.
# Sepolia RPC endpoint, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
SEPOLIA_RPC_URL=
# Private key of a throwaway deployer wallet holding only Sepolia test ETH (0x-prefixed)
DEPLOYER_PRIVATE_KEY=
# Etherscan API key (one key works for Sepolia) — used by `npm run verify:sepolia`
ETHERSCAN_API_KEY=
# Optional: Diamond Patron threshold in ETH (default 1 locally, 0.01 on testnets)
DIAMOND_TIER_THRESHOLD_ETH=

# Local Hardhat by default. For Sepolia use your Alchemy/Infura URL and CHAIN_ID=11155111.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Enter a real JWT only in your local ignored .env; never commit it.
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs
MAX_UPLOAD_BYTES=10485760
MAX_MEDIA_BYTES=52428800

# Deployed contracts (see frontend/src/contracts/addresses.json).
# Sepolia: PLATFORM_ADDRESS=0x522a90676C43b8EDEf460235CEa0bAa4Ae5bb35f
#          GOVERNANCE_TOKEN_ADDRESS=0x7D921748E55cdc2A0120551F4bdFE6A57bcBf883
#          DIAMOND_NFT_ADDRESS=0x9B5EbC653EFD26c232a3061c1CeC9A72718Dc2EF
PLATFORM_ADDRESS=
GOVERNANCE_TOKEN_ADDRESS=
DIAMOND_NFT_ADDRESS=
TOKEN_DECIMALS=18
TOKEN_TIER_THRESHOLD=1000

# AES-256 key (base64, 32 bytes) for access-controlled IPFS files (proof, exclusive).
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Losing or changing it makes previously uploaded protected files unreadable.
FILE_ENCRYPTION_KEY=
AUTH_MAX_AGE_SECONDS=300

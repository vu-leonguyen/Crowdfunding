# Copy to frontend/.env.local (git-ignored) to override defaults.
# CrowdOps backend (FastAPI) used for IPFS upload and role-checked file access.
VITE_API_URL=http://127.0.0.1:8000
# IPFS gateway for opening public files (proposal, media, metadata).
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
